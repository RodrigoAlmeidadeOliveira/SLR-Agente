title = {Towards an adaptation of the COCOMO cost model to the software measurement theory},
year = {1997},
isbn = {3540635319},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1145/267895.267932},
doi = {10.1145/267895.267932},
