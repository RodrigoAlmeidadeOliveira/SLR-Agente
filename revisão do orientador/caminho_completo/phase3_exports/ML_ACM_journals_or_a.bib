title = {ICMLT '23: Proceedings of the 2023 8th International Conference on Machine Learning Technologies},
year = {2023},
isbn = {9781450398329},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
location = {Stockholm, Sweden}
