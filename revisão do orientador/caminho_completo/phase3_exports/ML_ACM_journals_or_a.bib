editor = {Edna Dias Canedo, Daniel de Paula Porto, F{\'a}bio L{\'u}cio Lopes Mendon{\c c}a, Rafael Tim{\'o}teo de Sousa J{\'u}nior, Monalessa Perini Barcellos, Ismayle Sousa Santos, Sheila Reinehr, Sergio Soares, Uir{\'a} Kulesza, {\'E}rica Ferreira de Souza, Adriano Albuquerque, Carla Bezerra, Rodrigo Santos, Alessandro Garcia, Simone Dornelas Costa and Adolfo Gustavo Serra Seca Neto},
