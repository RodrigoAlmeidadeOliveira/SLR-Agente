@inproceedings{10.1145/3806096.3844833,
author = {Roy, Amburi},
title = {AI Context is an Engineering Artifact},
year = {2026},
isbn = {9798400726385},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3806096.3844833},
doi = {10.1145/3806096.3844833},
abstract = {AI coding assistants are embedded across the software development lifecycle, yet the context they consume—team conventions, architectural decisions, and design principles—is treated as ephemeral prompt input rather than a governed engineering artifact; this ephemeral treatment is itself a failure class. We classify these failures as violations of Context Integrity—the property that shared AI context remains consistent, trustworthy, deduplicated, and synchronized. This failure classification is decomposed into four failure modes, one per invariant. We propose the Context Integrity Preservation Pattern: a versioned artifact governed through Create, Maintain, Inject, and Synchronize, requiring no model changes. Production evaluation indicates that context presence, not prompt sophistication, is a primary factor in architectural correctness: sessions with context converge where iterated prompting without context fails; the pattern held across commercially distinct AI models and independent open-source codebases, consistent with the failure class being structural to AI-assisted workflows rather than specific to any tool or model.},
booktitle = {Proceedings of the ACM AI Leadership Summit 2026},
articleno = {34},
numpages = {5},
keywords = {AI code generation, context engineering, context integrity, context store, truth drifting, retrieval-augmented generation, software engineering, alignment, AI-assisted software development, large language models},
location = {Atlanta, GA, USA},
series = {AI Summit '26}
}

