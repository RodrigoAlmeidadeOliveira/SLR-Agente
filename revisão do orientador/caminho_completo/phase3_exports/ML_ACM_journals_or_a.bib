abstract = {The core thesis of this paper could easily be reproduced in the original environment. The authors provided an almost fully automated set of scripts that automatically execute the experiments. The experimental data was automatically collected and plotted. The resulting figures have some minor deviations from the originals, but the overall trends remain the same, and hence they can be considered a good fit.},
booktitle = {Reproducibility Reports of the 2024 International Conference on Management of Data},
pages = {28–31},
numpages = {4},
keywords = {bayesian inference, probabilistic databases, probabilistic programming, reproducibility},
