@inproceedings{10.1145/3779208.3785416,
author = {Lei, Zeyu and Tuncay, G{\"u}liz Seray and Imran, Abdullah and Celik, Z. Berkay and Bianchi, Antonio},
title = {A First Look at the Mobile Driving License (mDL) Standard and its Real-world Usage},
year = {2026},
isbn = {9798400723568},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3779208.3785416},
doi = {10.1145/3779208.3785416},
abstract = {The mobile driving licenses (mDL) standard enables the replacement of physical licenses with secure digital copies. This standard has been progressively adopted by more and more entities, including some U.S. states, and implemented by mobile app developers.As this standard deals with sensitive information, its correctness is of paramount importance. Unfortunately, no previous work has performed a systematic analysis to ensure the correctness of the standard and its implementations.In this paper, we present the first systematic security analysis of the mDL standard. Our analysis starts with extracting the critical implementation requirements from the specification. We then model multiple mDL usage scenarios by building a dedicated verification framework based on ProVerif. Our formal model highlights potential attacks that could occur if requirements are incorrectly implemented and generates step-by-step attack traces for these attacks. Starting from these attack traces, we then built mDLVerif, a black-box differential dynamic analysis tool, to analyze mDL reader apps in the market and evaluate their compliance with the mDL standard. Our study proves the overall correctness of the specification. However, we find that fulfilling the identified mDL implementation requirements is challenging for developers. Our formal model also highlights that these mistakes can lead to severe security implications, such as authentication failure and unauthorized access to restricted resources. In fact, our automated app analysis reveals that all six apps in our dataset implement the mDL standard in a way that is not compliant with the specification.},
booktitle = {Proceedings of the ACM Asia Conference on Computer and Communications Security},
pages = {83–97},
numpages = {15},
keywords = {Mobile Driving License, Mobile Security, Formal Verification, Dynamic Analysis, Implementation Security, Authentication},
location = {Bangalore, India},
series = {ASIA CCS '26}
}

