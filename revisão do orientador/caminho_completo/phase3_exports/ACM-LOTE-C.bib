@proceedings{10.1145/3678722,
title = {FUZZING 2024: Proceedings of the 3rd ACM International Fuzzing Workshop},
year = {2024},
isbn = {9798400711121},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {It is our great pleasure to welcome you to the 3rd International Workshop on Fuzzing (FUZZING 2024), co-located with ISSTA in Vienna, Austria on 16 September 2024. This workshop is the continuation of a two-year series of workshops that introduced a preregistration-based publication process to our community. Similar to the last two years, this workshop hosts the presentations of the accepted drafts of the registered reports that were accepted as part of the first stage in a two-stage publication process. In the first stage, the program committee (PC) evaluates all submissions based on:    (i) the significance and novelty of the hypotheses or techniques and    (ii) the soundness and reproducibility of the methodology specified to validate the claims or hypotheses -- but explicitly not based on the strength of the (preliminary) results.    These draft registered reports are presented and improved at the FUZZING 2024 workshop in Vienna.},
location = {Vienna, Austria}
}

@inproceedings{10.1145/3788853.3803096,
author = {Gugnani, Shashank and Ahmed, Shadab and Pednekar, Shubham and Gowda, Sanju and Tandon, Sarvesh and Pendse, Sukhada},
title = {From JSON to Duality: Automated Application Migration from Document to Relational Databases},
year = {2026},
isbn = {9798400724503},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788853.3803096},
doi = {10.1145/3788853.3803096},
abstract = {Developers like the simplicity and flexibility of document databases. However, they are left frustrated with data denormalization and the lack of critical features (such as transactions, SQL access, and performance) in document databases. To address this growing problem, we introduce the JSON-to-Duality Migrator, an automated tool for migrating applications from document databases to Oracle. The migrator allows developers to (1) design an effective normalized relational schema, derived from an existing set of JSON collections, (2) migrate data from a document database to Oracle, while transforming to the target schema, and (3) lift-and-shift the application transparently with minimal to no code changes. The JSON-to-Duality Migrator utilizes unsupervised artificial intelligence algorithms to automate these steps while simultaneously addressing the non-trivial challenge of supporting schema flexibility for applications. It derives a 2NF-compliant (and 3NF in most cases) normalized relational schema by discovering semantically overlapping attributes and mining functional dependencies across and within collections in the denormalized dataset. Furthermore, the migrator utilizes the concept of duality views, which are updatable JSON views on top of relational data, a new feature in Oracle AI Database 26ai, to preserve the object model desired by applications. For each JSON collection in the denormalized dataset, we create a duality view over the inferred normalized relational schema, which matches the shape of that collection. This allows applications to transparently migrate to a relational database while maintaining the document-centric application model.},
booktitle = {Companion of the International Conference on Management of Data},
pages = {307–319},
numpages = {13},
keywords = {nosql, sql, json, relational, migration, duality},
location = {Bengaluru, India},
series = {SIGMOD Companion '26}
}

