@inproceedings{10.1145/3788853.3803095,
author = {Baltieri, Fabio and Beran, Bora and Bernstein, Igor and Borda, Aimee and Chan, Adrian and D'Andrea, Mark and Dashyan, Artak and Dharan, Ramesh and Dinnyes, Gabor and Dominguez, Mike and Dorland, Eric and Duenas, Jose and Elliott, Gary and Furtado, Bruno and Garcia, Madison and Garolera Huguet, Mar{\c c}al and Gleason, Brendan and Hawkins, Alexis and Hurwitz, Jeremy and Irani, Anoshak and Jog, Rohit and Kadambi, Sudarshan and Khemka, Vikram and Krishnamurthy, Sailesh and Krivokon, Maxim and Lee, Bruce and Li, Xiaozhou and Magrino, Tom and Maly, Matt and Mangrich, Mark and McErlean, Douglas and Montes, Pablo and Moore, Li and Morales, Eduardo and Morris, Greg and Nguyen, An and Niemitz, Steve and Prabhu Gaonkar, Gaurav and Rutherford, Jim and Ryan, Stephen and Saha, Sho and Sarcar, Kanoj and Schmidt, Cristina and Shyshkalov, Andrii and Suryadevara, Pratibha and Suttle, Nick and Tawar, Anvit and Tobin, John and Uang, Justin and Vemuru, Phaneendhar and Verma, Harendra and Verma, Shitanshu and Wang, Jinghang and Wegorek, Michal and Yau, Siu and Ziukas, Andrius},
title = {Twenty Years of Bigtable},
