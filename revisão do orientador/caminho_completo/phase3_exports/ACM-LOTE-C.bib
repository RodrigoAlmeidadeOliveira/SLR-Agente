@proceedings{10.1145/3687998,
title = {SIGMOD '24: Reproducibility Reports of the 2024 International Conference on Management of Data},
year = {2025},
isbn = {9798400711794},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {This is the inaugural SIGMOD ARI Companion with Reproducibility Reports for SIGMOD papers that are fully reproduced following the ACM SIGMOD Availability and Reproducibility Initiative (ARI) process as outlined at https://reproducibility.sigmod.org/. The ACM SIGMOD 2024 Availability and Reproducibility Initiative requested from the authors of all papers presented in ACM SIGMOD 2024 to submit their artifacts for evaluation. The evaluation process may have a number of different outcomes. All papers for which the artifacts are made available received the "Artifacts Available" badge. Further, when the artifacts are found to be exercisable and well-documented, the corresponding papers received the "Artifacts Evaluated" badge. Finally, when the artifacts led to a full reproducibility of the presented results, the papers received the "Results Reproduced" badge. More details on the ACM badging can be found on the official ACM website: https://www.acm.org/publications/policies/artifact-review-and-badgingcurrent.From a total of 213 paper presented in SIGMOD 2024, we received 72 artifact submissions, 43 of targeting the "Artifacts Available" and "Artifacts Evaluated" and 29 targeting the "Results Reproduced" badge as well. After a thorough reproducibility review, 24 papers were found fully reproducible and the reviewers compiled reproducibility reports for each of those papers. We highlight that not finding a paper fully reproduced is not a negative result, rather, it is a "not yet reproduced" result and the authors may decide to submit their artifacts for reproducibility review in a subsequent round.},
location = {Santiago AA, Chile}
}

@inproceedings{10.1145/3676641.3716270,
author = {Yu, Pingshi and Wu, Nicolas and Donaldson, Alastair F.},
title = {Ratte: Fuzzing for Miscompilations in Multi-Level Compilers Using Composable Semantics},
year = {2025},
isbn = {9798400710797},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3676641.3716270},
doi = {10.1145/3676641.3716270},
abstract = {Multi-level intermediate representation (MLIR) is a rapidly growing compiler framework, with its defining feature being an ecosystem of modular language fragments called dialects. Specifying dialect semantics and validating dialect implementations presents novel challenges, as existing techniques do not cater for the modularity and composability required by MLIR. We present Ratte, a framework for specifying composable dialect semantics and modular dialect fuzzers. We introduce a novel technique for the development of semantics and fuzzers for MLIR dialects, enabling a harmonious cycle where the fuzzer validates the semantics via test-case generation, whilst at the same time the semantics allow the generation of high-quality test cases that are free from undefined behaviour. The composability of semantics and fuzzers allows generators to be cheaply derived to test combinations of dialects. We have used Ratte to find 6 previously-unknown miscompilation bugs in the production MLIR implementation. To our knowledge, Ratte is the first MLIR fuzzer capable of finding such bugs. Our work identified several aspects of the MLIR specification that were unclear, for which we proposed fixes that were adopted. Our technique provides composable reference interpreters for important MLIR dialects, validated against the production implementation, which can be used in future compiler development and testing research.},
booktitle = {Proceedings of the 30th ACM International Conference on Architectural Support for Programming Languages and Operating Systems, Volume 2},
pages = {966–981},
numpages = {16},
keywords = {compiler testing, composable semantics, differential testing, fuzzing, mlir},
location = {Rotterdam, Netherlands},
series = {ASPLOS '25}
}

