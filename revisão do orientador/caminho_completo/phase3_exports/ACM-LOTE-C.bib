@inproceedings{10.1145/3674805.3690742,
author = {Silva, Luciana Lourdes and Silva, Janio Rosa da and Montandon, Joao Eduardo and Andrade, Marcus and Valente, Marco Tulio},
title = {Detecting Code Smells using ChatGPT: Initial Insights},
year = {2024},
