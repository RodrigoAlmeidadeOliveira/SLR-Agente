@inproceedings{10.1145/3794786.3830780,
author = {Olshanskaia, Viktoriia and Tran, Duc Thinh and Parkkila, Janne and Knutas, Antti},
title = {Technological Landscape of Civic Tech: Current Practices and Lessons Learned},
year = {2026},
isbn = {9798400724831},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3794786.3830780},
doi = {10.1145/3794786.3830780},
abstract = {With the growing accessibility of digital technologies and open data, the activity of applying software technology to inform citizens and encourage civic engagement has become very widespread. Through civic tech and by using digital technology and platforms, people become empowered to leverage technology to influence change in society. Although civic tech received a lot of attention and funding from the early to late 2010s, nowadays many projects facing challenges related to sustainability, maintenance, and long-term contributor engagement. This research aims to advance understanding of the current state of software repository characteristics in civic tech projects. The study utilizes a mixed-method empirical research approach to explore civic tech projects. In the work, we collected and analyzed data from 55 civic tech projects. We adopted the open-source tool civic-tech-crawler to gather repository metrics and compute more than 25 indicators of software projects. We found that civic tech projects mostly web-oriented, have poor documentation, and nearly half of the analyzed projects demonstrate evidence of AI-assisted development practices. We also found that most of the work in a project is usually done by a very small group of contributors. At the same time, project activity does not decrease over projects age, showing constant community interest.},
booktitle = {Proceedings of the 2026 International Conference on Information Technology for Social Good},
pages = {402–410},
numpages = {9},
keywords = {civic tech, software repositories mining, tech for good},
location = {Pisa, Italy},
series = {GoodIT '26}
}

