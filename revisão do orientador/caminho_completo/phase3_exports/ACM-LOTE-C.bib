@inproceedings{10.1145/3803437.3805261,
author = {Bulut, Muhammed Fatih and DePaolis, Carlo and Batta, Raghav and Mangal, Anjali},
title = {AVDA: Autonomous Vibe Detection Authoring for Cybersecurity},
year = {2026},
isbn = {9798400726361},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803437.3805261},
doi = {10.1145/3803437.3805261},
abstract = {With the rapid advancement of AI in code generation, cybersecurity detection engineering faces new opportunities to automate traditionally manual processes. Detection authoring—the practice of creating executable logic that identifies malicious activities from security telemetry—is hindered by fragmented code across repositories, duplication, and limited organizational visibility. Current workflows remain heavily manual, constraining both coverage and velocity. In this paper, we introduce AVDA, a framework that leverages the Model Context Protocol (MCP) to automate detection authoring by integrating organizational context—existing detections, telemetry schemas, and style guides—into AI-assisted code generation. We evaluate three authoring strategies—Baseline, Sequential, and Agentic—across a diverse corpus of production detections and state-of-the-art LLMs. Our results show that Agentic workflows achieve a 19% improvement in overall similarity score over Baseline approaches, while Sequential workflows attain 87% of Agentic quality at 40{\texttimes} lower token cost. Generated detections excel at TTP matching (99.4%) and syntax validity (95.9%) but struggle with exclusion parity (8.9%). Expert validation on a 22-detection subset confirms strong Spearman correlation between automated metrics and practitioner judgment (ρ = 0.64, p &lt; 0.002). By integrating seamlessly into standard developer environments, AVDA provides a practical path toward AI-assisted detection engineering with quantified trade-offs between quality, cost, and latency.},
booktitle = {Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
pages = {903–913},
numpages = {11},
keywords = {cybersecurity, detection engineering, artificial intelligence},
location = {Montreal, QC, Canada},
series = {FSE Companion '26}
}

@inproceedings{10.1145/3593434.3593466,
author = {Chen, Xingru and Usman, Muhammad and Badampudi, Deepika},
title = {Using InnerSource for Improving Internal Reuse: An Industrial Case Study},
year = {2023},
isbn = {9798400700446},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3593434.3593466},
doi = {10.1145/3593434.3593466},
abstract = {Background: InnerSource consists of the use of open source development techniques within the corporation. It helps improve software reuse through increased transparency and inter-team collaboration. Companies need to understand their context and specific needs before deciding to adopt any specific InnerSource practices since they cannot apply all InnerSource practices at once. Aim: This study aims to support the case company in assessing its readiness for adopting InnerSource practices to improve its internal reuse, identify and prioritize the improvement areas, and identify suitable solutions. Method: We performed a case study using a questionnaire and a workshop to check the current and desired status of adopting InnerSource practices and collect potential solutions. Results: The study participants identified that the company needs to prioritize the improvements related to the discoverability, communication channels, and ownership of the reusable assets. In addition, they identified certain InnerSource practices as solutions for the prioritized improvement areas, such as better structured repositories for storing and searching the reusable assets and standardized documentation of the reusable assets. Conclusion: The questionnaire instrument aids the case company in identifying the improvement areas related to InnerSource and reuse practices. InnerSource practices could improve the development and maintenance of reusable assets. Keywords: InnerSource, software reuse, readiness},
booktitle = {Proceedings of the 27th International Conference on Evaluation and Assessment in Software Engineering},
pages = {348–357},
numpages = {10},
location = {Oulu, Finland},
series = {EASE '23}
}

@inproceedings{10.1145/3779657.3779663,
author = {AlJabali, Ayah and Aldalaien, Muawya},
title = {Secure XP Programming: Integrating OWASP Practices and Lightweight Threat Modelling into Extreme Programming},
year = {2026},
isbn = {9798400715778},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3779657.3779663},
doi = {10.1145/3779657.3779663},
abstract = {In today’s world, Extreme Programming (XP) has become a well known method due to its detailed focus on feedback, iterative progress, and close collaborations with its users. However, its original design does not ensure coordinated mechanisms for detecting security threats throughout the development process. Therefore, to fix this breach, this paper presents Secure XP Programming, a lightweight improvement to XP that links essential security practices without jeopardizing agility. By incorporating OWASP principles and introducing a focused way called Lightweight Continuous Threat Modeling (LCTM), this method combines security into key XP practices such as the Planning Game, Test-Driven Development (TDD), Pair Programming, and Continuous Integration. These improvements include Security Stories, Security Acceptance Criteria, Secure Pair Programming, and automated vulnerability scanning during CI pipelines. LCTM enables teams to address future threats early during sprint planning through a straightforward checklist-based interpretation aligned with OWASP Top 10 and ASVS standards. Secure XP builds a culture of security awareness and shared responsibility within development teams. Conceptual evaluation indicates that this approach strengthens baseline security while sustaining XP’s fast-paced delivery model, making secure software development more practical and accessible in real world agile environments.},
booktitle = {Proceedings of the 2025 7th World Symposium on Software Engineering},
pages = {34–41},
numpages = {8},
keywords = {Agile Security, Secure Software Development, Secure XP Programming, Lightweight Threat Mitigation},
location = {Okayama, Japan},
series = {WSSE '25}
}

