@proceedings{10.1145/3615893,
title = {GeoWildLife '23: Proceedings of the 1st ACM SIGSPATIAL International Workshop on AI-driven Spatio-temporal Data Analysis for Wildlife Conservation},
year = {2023},
isbn = {9798400703553},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {Welcome to the inaugural edition of the GeoWildLife Workshop Proceedings, a synopsis of knowledge, ideas, and collaborative insights from the 1st ACM SIGSPATIAL International Workshop on AI-driven Spatio-temporal Data Analysis for Wildlife Conservation (GeoWildLife 2023). In the preface of these proceedings, it is essential to reflect on the impetus behind the workshop. As we traverse the Anthropocene, the confluence of human expansion and wildlife conservation poses intricate challenges. The complexities of monitoring vast and biodiverse ecosystems call for not just innovative approaches but also robust, scalable solutions. Our workshop—situated at this critical nexus—aims to propel the frontiers of artificial intelligence (AI), geospatial science, and ecology to foster a sustainable coexistence of human and wildlife.},
