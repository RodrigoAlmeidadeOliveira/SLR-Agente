@inproceedings{10.1145/3640537.3641577,
author = {Nahian, Ahamed Al and Demsky, Brian},
title = {FlowProf: Profiling Multi-threaded Programs using Information-Flow},
year = {2024},
isbn = {9798400705076},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3640537.3641577},
doi = {10.1145/3640537.3641577},
abstract = {Amdahl's law implies that even small sequential bottlenecks can seriously limit the scalability of multi-threaded programs. To achieve scalability, developers must painstakingly identify sequential bottlenecks in their program and eliminate these bottlenecks by either changing synchronization strategies or rearchitecting and rewriting any code with sequential bottlenecks. This can require significant effort by the developer to find and understand how to fix sequential bottlenecks. To address the issue, we bring a new tool, information flow, to the problem of understanding sequential bottlenecks. Information flow can help developers understand whether a bottleneck is fundamental to the computation, or merely an artifact of the implementation.    First, our strategy tracks memory access conflicts to find over-synchronized applications where redesigning the synchronization strategy on existing implementation can improve performance. Then, information flow analysis finds optimization opportunities where changing the existing implementation can improve performance of applications that have bottlenecks due to unnecessary memory access conflicts. We implemented this in FlowProf. We have evaluated FlowProf on a set of multi-threaded Java applications where the generated optimization insights achieve performance gains of up to 58%.},
booktitle = {Proceedings of the 33rd ACM SIGPLAN International Conference on Compiler Construction},
pages = {137–149},
numpages = {13},
keywords = {Dynamic Program Analysis, Optimization, Profiling, Scalable Concurrency Control, Synchronization},
location = {Edinburgh, United Kingdom},
series = {CC 2024}
}

@inproceedings{10.1145/3652620.3687815,
author = {Raeisdanaei, Ali and Murphy, Logan and Di Sandro, Alessio and Askarpour, Mehrnoosh and Viger, Torin and Chechik, Marsha},
title = {Evaluation of Automotive OTA Updates Using Assurance Cases},
year = {2024},
isbn = {9798400706226},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3652620.3687815},
doi = {10.1145/3652620.3687815},
abstract = {Software-intensive vehicles require regular over-the-air (OTA) updates. To ensure that OTA updates do not compromise system safety, such updates should be assured. Automotive safety engineers need to efficiently estimate the effort it would take to assure these updates for the entire fleet. To address this challenge, we propose a process for supporting assurance of OTA updates. Our process proposes to model the fleet of vehicles as a software product line (SPL), assured with a variability-aware assurance case. It then measures the difficulty of assuring the proposed update using this variability-aware AC model via a set of heuristics.},
booktitle = {Proceedings of the ACM/IEEE 27th International Conference on Model Driven Engineering Languages and Systems},
pages = {720–724},
numpages = {5},
keywords = {assurance, over-the-air updates, impact assessment},
location = {Linz, Austria},
series = {MODELS Companion '24}
}

@inproceedings{10.1145/3797867.3829029,
author = {Leonardi, Nicola and Manca, Marco and Patern{\`o}, Fabio},
title = {Beyond LLMs: Small Multimodal Models for Semantic Accessibility Validation of Alternative Texts},
year = {2026},
isbn = {9798400725210},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3797867.3829029},
doi = {10.1145/3797867.3829029},
abstract = {Generative artificial intelligence is opening up new possibilities in Web accessibility authoring and validation. Multimodal language models can address semantic analyses of Web content that have not been provided so far. Indeed, most available accessibility validation tools are limited to syntactic analysis, focusing mainly on whether required elements are present. Some work has been put forward to explore the possibilities of large language models. However, such models raise several issues regarding cost, privacy, and sustainability. To address such issues, we have conducted a study investigating the feasibility of small, open-weighted models for the semantic analysis of a common accessibility issue: whether the alternative textual descriptions of images provide sufficient equivalent information (Success Criterion 1.1.1 Non-text Content). In the paper, we present how we have fine-tuned the small language model, and the results of a user test involving 30 experts in accessibility validation, in which they had to rate the results of the assessment performed by a large language model (GPT–4o), a small visual-language model and perform the same task themselves over 645 images. The results show that visual-language models can provide useful support for this type of task, and a small, appropriately trained language model tends to achieve even better results than a large one. These results show that novel paths for authoring and validating Web content accessibility can be enabled by small language models.},
booktitle = {Proceedings of the 28th International ACM SIGACCESS Conference on Computers and Accessibility},
articleno = {28},
numpages = {16},
keywords = {Accessibility, LLM, SLM, User validation},
location = {Porto, Portugal},
series = {ASSETS '26}
}

